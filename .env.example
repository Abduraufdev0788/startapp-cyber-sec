# ==============================================================================
# Telegram Phishing & Scam Detection Platform — Environment Configuration
# NEVER commit the actual .env file with real secrets to source control.
# ==============================================================================

# Environment mode: development | staging | production
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
PROJECT_NAME="Telegram Phishing & Scam Detection Platform"
PORT=8000

# ------------------------------------------------------------------------------
# Administrator Setup & Security
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@phishguard.uz
INITIAL_ADMIN_PASSWORD=AdminPhishGuard2025!
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# Security & Cryptography
# ------------------------------------------------------------------------------
# APP_MASTER_KEY must be a 64-hex-character string (32 bytes).
# Generate securely via: openssl rand -hex 32
APP_MASTER_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
JWT_SECRET_KEY=change-this-to-a-super-secret-random-jwt-key-with-at-least-64-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# Database & Redis Infrastructure
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=phishing_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/phishing_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/phishing_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_URL=redis://:redis_secure_password@localhost:6379/0

# ------------------------------------------------------------------------------
# Telegram Credentials
# ------------------------------------------------------------------------------
# Obtain API_ID and API_HASH from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
# Obtain Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_example

# ------------------------------------------------------------------------------
# AI Provider (Google Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Scanner & Network Constraints (SSRF & DoS Defenses)
# ------------------------------------------------------------------------------
SCANNER_CONNECT_TIMEOUT_SECONDS=5
SCANNER_TOTAL_TIMEOUT_SECONDS=10
SCANNER_MAX_RESPONSE_BYTES=2097152 # 2 MB limit
SCANNER_MAX_REDIRECTS=5
